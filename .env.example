# Nuclear backend configuration. Copy this file to `.env` and fill in values.
# Node loads `.env` automatically (process.loadEnvFile). Keep real secrets in
# `.env` only (git-ignored) — never commit them here.

# Region / iTunes storefront (ISO 3166-1 alpha-2). Default: in (India)
NUCLEAR_COUNTRY=in

# --- Spotify (better track search/metadata) -----------------------------------
# NOTE: Spotify's Web API now requires the app owner to have Spotify Premium;
# without it, search returns 403 and the backend falls back to iTunes.
# Create an app at https://developer.spotify.com/dashboard (client-credentials).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Last.fm (recommendations / "you might like") -----------------------------
# Get a free API key at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# --- yt-dlp (optional) --------------------------------------------------------
# Path to the yt-dlp binary; auto-detected on Windows if omitted.
# YTDLP_PATH=
